<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulaire d'affectation par Hôtel -->
    <record id="view_hotel_channel_manager_form" model="ir.ui.view">
        <field name="name">hotel.channel.manager.form</field>
        <field name="model">hotel.channel.manager</field>
        <field name="arch" type="xml">
            <form string="Configuration Channel Manager (Hôtel)">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,inactive"/>
                    <button name="action_set_active" string="Activer" type="object" class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_set_inactive" string="Désactiver" type="object" invisible="state == 'inactive'"/>
                    <button name="action_set_draft" string="Remettre en brouillon" type="object" invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="hotel_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Liste -->
    <record id="view_hotel_channel_manager_tree" model="ir.ui.view">
        <field name="name">hotel.channel.manager.tree</field>
        <field name="model">hotel.channel.manager</field>
        <field name="arch" type="xml">
            <list string="Channel Managers par Hôtel">
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_channel_manager" model="ir.actions.act_window">
        <field name="name">Channel Managers</field>
        <field name="res_model">hotel.channel.manager</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hotel_channel_manager_root" 
              name="Channel Manager" 
              action="action_hotel_channel_manager" 
              sequence="10"/>
    <!-- 2. Le sous-menu Action pour la liste des Channel Managers -->
    <menuitem id="menu_hotel_channel_manager_sub" 
              name="Channel Managers" 
              parent="menu_hotel_channel_manager_root" 
              action="action_hotel_channel_manager" 
              sequence="10"/>
    <!-- 6. Menu de configuration rattaché au menu "Hôtels" -->
    <menuitem id="menu_hotel_channel_manager_config" 
              name="Configuration" 
              parent="menu_hotel_channel_manager_root" 
              action="api_gds.action_api_gds_config" 
              sequence="20"/>
</odoo>