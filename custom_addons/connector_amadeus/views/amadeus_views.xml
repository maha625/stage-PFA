<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_travel_booking_form" model="ir.ui.view">
        <field name="name">travel.booking.form</field>
        <field name="model">travel.booking</field>
        <field name="arch" type="xml">
            <form string="Réservation de Voyage GDS">
                <header>
                    <button name="action_fetch_pnr" string="Extraire PNR GDS" type="object" class="oe_highlight" data-hotkey="v"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pnr_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Réponse Technique API (JSON)">
                            <field name="flight_details" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_travel_booking" model="ir.actions.act_window">
        <field name="name">Dossiers GDS</field>
        <field name="res_model">travel.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_travel_root" name="Voyages &amp; GDS" sequence="10"/>
    <menuitem id="menu_travel_booking" name="Dossiers PNR" parent="menu_travel_root" action="action_travel_booking" sequence="20"/>
</odoo>