<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Vue Liste (Tableau des PNR) -->
    <record id="view_travel_booking_list" model="ir.ui.view">
        <field name="name">travel.booking.list</field>
        <field name="model">travel.booking</field>
        <field name="arch" type="xml">
            <list string="Dossiers PNR">
                <field name="name"/>
                <field name="pnr_code"/>
                <field name="gds_provider"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- 2. Vue Formulaire -->
    <record id="view_travel_booking_form" model="ir.ui.view">
        <field name="name">travel.booking.form</field>
        <field name="model">travel.booking</field>
        <field name="arch" type="xml">
            <form string="Réservation de Voyage GDS">
                <header>
                    <button name="action_realtime_flight_search" string="Rechercher Vols (Temps Réel)" type="object" class="oe_highlight" data-hotkey="s"/>
                    <button name="action_fetch_pnr" string="Extraire PNR GDS" type="object" class="oe_highlight" data-hotkey="v"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pnr_code"/>
                            <field name="gds_provider"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Réponse Technique API (JSON)">
                            <field name="flight_details" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Action de la fenêtre (Ordre d'affichage : list en premier) -->
    <record id="action_travel_booking" model="ir.actions.act_window">
        <field name="name">Dossiers GDS</field>
        <field name="res_model">travel.booking</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_travel_booking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_travel_booking_form')})]"/>
    </record>

    <!-- 4. Menu principal -->
    <menuitem id="menu_travel_booking" name="Dossiers PNR" parent="api_gds.menu_gds_root" action="action_travel_booking" sequence="20"/>

</odoo>