<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 0. Menu Racine Principal "Hôtels" -->
    <menuitem id="menu_hotel_root" 
              name="Hôtels" 
              sequence="10"/>

    <!-- 1. Vue Liste (Historique des recherches) -->
    <record id="view_hotel_search_wizard_tree" model="ir.ui.view">
        <field name="name">hotel.search.wizard.tree</field>
        <field name="model">hotel.search.wizard</field>
        <field name="arch" type="xml">
            <list string="Historique des Recherches">
                <field name="create_date"/>
                <field name="city"/>
                <field name="destination_code"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="rooms"/>
                <field name="adults"/>
            </list>
        </field>
    </record>

    <!-- 2. Vue Formulaire (Détails et résultats) -->
    <record id="view_hotel_search_wizard_form" model="ir.ui.view">
        <field name="name">hotel.search.wizard.form</field>
        <field name="model">hotel.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Recherche Hôtelière Globale (Hotelbeds)">
                <header>
                    <button name="action_search_hotels" string="Lancer la Recherche en Direct" type="object" class="btn-primary oe_highlight"/>
                </header>
                <sheet>
                    <group string="Localisation &amp; Critères de Voyage">
                        <group>
                            <field name="api_provider" widget="radio"/>
                            <field name="country" placeholder="ex: Espagne, France"/>
                            <field name="city" placeholder="ex: Paris, Palma"/>
                            <field name="destination_code" placeholder="ex: PMI, PAR"/>
                        </group>
                        <group>
                            <field name="checkin_date"/>
                            <field name="checkout_date"/>
                            <field name="rooms"/>
                            <field name="adults"/>
                            <field name="children"/>
                            <field name="child_age" invisible="children == 0"/>
                            <field name="max_hotels"/>
                        </group>
                    </group>
                    <notebook string="Résultats">
                        <page string="Offres &amp; Disponibilités Trouvées">
                            <field name="search_results" widget="html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Action de la fenêtre pour la liste des recherches -->
    <record id="action_hotel_search_wizard" model="ir.actions.act_window">
        <field name="name">Recherche d'Hôtels</field>
        <field name="res_model">hotel.search.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- 4. Menu pour accéder à la liste des recherches -->
    <menuitem id="menu_hotel_search" 
              name="Recherche d'Hôtels" 
              parent="menu_hotel_root" 
              action="action_hotel_search_wizard" 
              sequence="15"/>

    <!-- 5. Action pour les paramètres de configuration GDS -->
    <record id="action_api_gds_config" model="ir.actions.act_window">
        <field name="name">Configuration GDS</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'api_gds'}</field>
    </record>

    <!-- 6. Menu de configuration rattaché au menu "Hôtels" -->
    <menuitem id="menu_gds_config" 
              name="Configuration" 
              parent="menu_hotel_root" 
              action="action_api_gds_config" 
              sequence="100"/>

</odoo>