<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Formulaire Connecteur -->
    <record id="view_hotel_connector_form" model="ir.ui.view">
        <field name="name">hotel.connector.form</field>
        <field name="model">hotel.connector</field>
        <field name="arch" type="xml">
            <form string="Connecteur Hotelbeds">
                <header>
                    <!-- Utilisation du vrai nom technique du module : connector_hotelbeds -->
                    <button name="%(connector_hotelbeds.action_hotel_search_wizard)d" 
                            string="Rechercher des Hôtels" 
                            type="action" 
                            class="oe_highlight"/>
                    <button name="action_check_availability" 
                            string="Tester Connexion Rapide" 
                            type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="api_endpoint"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Résultats en Direct (Disponibilités / Tarifs)">
                            <field name="last_search_result" widget="text" nolabel="1" placeholder="Les résultats de l'API s'afficheront ici..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Liste (Tree) Connecteur -->
    <record id="view_hotel_connector_tree" model="ir.ui.view">
        <field name="name">hotel.connector.tree</field>
        <field name="model">hotel.connector</field>
        <field name="arch" type="xml">
            <list string="Connecteurs Hôteliers">
                <field name="name"/>
                <field name="api_endpoint"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action Connecteur -->
    <record id="action_hotel_connector" model="ir.actions.act_window">
        <field name="name">Connecteurs Hôteliers</field>
        <field name="res_model">hotel.connector</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Principal et Sous-menu Connecteur -->
    <menuitem id="menu_hotel_root" name="Grossistes Hôtels" sequence="10"/>
    <menuitem id="menu_hotel_connector" name="Connecteurs" parent="menu_hotel_root" action="action_hotel_connector" sequence="20"/>

</odoo>