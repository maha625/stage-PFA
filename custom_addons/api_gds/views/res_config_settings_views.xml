<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_gds" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.gds</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Connectivité GDS" name="api_gds">
                    
                    <!-- Paramètres Amadeus -->
                    <block title="Paramètres API Amadeus">
                        <setting id="amadeus_environment_setting" string="Environnement Amadeus" help="Sélectionnez l'environnement cible pour Amadeus">
                            <field name="amadeus_environment" widget="radio"/>
                        </setting>
                        <setting id="amadeus_client_id_setting" string="Client ID (Amadeus)" help="Identifiant client Amadeus">
                            <field name="amadeus_client_id"/>
                        </setting>
                        <setting id="amadeus_client_secret_setting" string="Client Secret (Amadeus)" help="Clé secrète Amadeus">
                            <field name="amadeus_client_secret" password="True"/>
                        </setting>
                    </block>

                    <!-- Paramètres Sabre -->
                    <block title="Paramètres API Sabre">
                        <setting id="sabre_environment_setting" string="Environnement Sabre" help="Sélectionnez l'environnement cible pour Sabre">
                            <field name="sabre_environment" widget="radio"/>
                        </setting>
                        <setting id="sabre_client_id_setting" string="Client ID / Username (Sabre)" help="Identifiant client Sabre">
                            <field name="sabre_client_id"/>
                        </setting>
                        <setting id="sabre_client_secret_setting" string="Client Secret / Password (Sabre)" help="Clé secrète Sabre">
                            <field name="sabre_client_secret" password="True"/>
                        </setting>
                        <setting id="sabre_pcc_setting" string="PCC (Sabre)" help="Pseudo City Code ou iPCC attribué par Sabre">
                            <field name="sabre_pcc"/>
                        </setting>
                    </block>

                    <!-- Paramètres Galileo -->
                    <block title="Paramètres API Galileo (Travelport)">
                        <setting id="galileo_environment_setting" string="Environnement Galileo" help="Sélectionnez l'environnement cible pour Galileo">
                            <field name="galileo_environment" widget="radio"/>
                        </setting>
                        <setting id="galileo_client_id_setting" string="API Key / Username (Galileo)" help="Identifiant client Galileo">
                            <field name="galileo_client_id"/>
                        </setting>
                        <setting id="galileo_client_secret_setting" string="API Secret / Password (Galileo)" help="Clé secrète Galileo">
                            <field name="galileo_client_secret" password="True"/>
                        </setting>
                    </block>

                    <!-- Autres paramètres -->
                    <block title="Paramètres Hotelbeds / Grossistes Hôteliers">
                        <setting id="hotelbeds_api_key_setting" string="API Key" help="Clé API principale pour Hotelbeds">
                            <field name="hotelbeds_api_key"/>
                        </setting>
                        <setting id="hotelbeds_shared_secret_setting" string="Shared Secret" help="Secret partagé pour la signature cryptographique SHA-256">
                            <field name="hotelbeds_shared_secret" password="True"/>
                        </setting>
                    </block>
                    
                    <block title="Paramètres API Ninjas (Recherche d'Aéroports)">
                        <setting id="api_ninjas_key_setting" string="API Key (API Ninjas)" help="Clé API pour la recherche d'aéroports">
                            <field name="api_ninjas_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_api_gds_config" model="ir.actions.act_window">
        <field name="name">Configuration GDS</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'api_gds'}</field>
    </record>

    <!-- Lien vers le menu de configuration sous la racine -->

</odoo>